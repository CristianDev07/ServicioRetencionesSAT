# PASO 1: conexión a SQL Server
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=SERVIDOR\INSTANCIA
DB_NAME=Sistema-Corporativo
DB_TRUSTED_CONNECTION=yes
DB_ENCRYPT=no
DB_TRUST_SERVER_CERTIFICATE=yes

# Si se usa autenticación SQL:
# DB_TRUSTED_CONNECTION=no
# DB_USER=usuario_servicio
# DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR

# PASO 2: carpetas controladas
RETENCIONES_ROOT_DIR=C:\SistemaCorporativo\Uploads\ProyectoListo\cfdis
# RETENCIONES_LOG_DIR=C:\SistemaCorporativo\Uploads\ProyectoListo\cfdis\_procesos\Retenciones\logs
FIEL_STORAGE_DIR=C:\SistemaCorporativo\Uploads\ProyectoListo

# PASO 3: credenciales y comunicación SAT
FERNET_KEY=CAMBIAR_EN_EL_SERVIDOR
SAT_REQUEST_TIMEOUT_SECONDS=60
SAT_TOKEN_REUSE_SECONDS=240
SAT_VERIFY_TLS=yes
SAT_DOWNLOAD_LEASE_MINUTES=15

# PASO 4: histórico automático, seguimiento y horario diario
SAT_DAILY_TIME=02:00
SAT_TIMEZONE=America/Mexico_City
SAT_HISTORICAL_COMPANIES=1
SAT_FOLLOWUP_MINUTES=15

# PASO 5: avisos del servicio
TELEGRAM_ENABLED=no
TELEGRAM_BOT_TOKEN=CAMBIAR_EN_EL_SERVIDOR
TELEGRAM_CHAT_ID=CAMBIAR_EN_EL_SERVIDOR
TELEGRAM_TIMEOUT_SECONDS=15

# Opciones operativas
ZIP_PATTERN=*.zip
LOG_LEVEL=INFO
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=10
SAT_POLL_SECONDS=60
SAT_MAX_WAIT_MINUTES=30
